POSTGRES_USER=alt_credit
POSTGRES_PASSWORD=alt_credit_secret
POSTGRES_DB=alt_credit_vault
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# 64-char hex string (32 bytes) for AES-256
AES_SECRET_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Groq API key for survey text analysis
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama3-8b-8192

# Admin API key (protects /score/train and /ingest/ground_truth)
API_KEY=

# CORS origins (comma-separated, or * for all)
CORS_ORIGINS=*

# Storage backend. Default is Postgres (the deployed configuration: uses the
# POSTGRES_* vars above, or a DATABASE_URL if provided — DATABASE_URL wins).
# Set USE_SQLITE=true ONLY for an optional zero-dependency local laptop demo
# (a SQLite file, no Docker/Postgres). Leave false for Docker/Render.
USE_SQLITE=false
SQLITE_PATH=./alt_credit.db

# Seed the demo borrower cohort into an empty DB on startup (zero-friction demo).
SEED_ON_STARTUP=true

# Legacy flag (unused by the SQLite path; kept for the Docker/Postgres compose).
AUTO_SEED_ON_STARTUP=false
